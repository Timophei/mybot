# ---- Telegram ----
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Внешний адрес сайта, на котором nginx проксирует бота (без слеша в конце)
WEBHOOK_BASE_URL=https://b-integration.ru
# Путь вебхука; должен совпадать с location в nginx
WEBHOOK_PATH=/mybot/tg
# Случайная строка: openssl rand -hex 32  (Telegram присылает её в заголовке, чужие запросы отбрасываются)
WEBHOOK_SECRET=
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8085

# ---- Битрикс24 ----
# Входящий вебхук: Разработчикам → Другое → Входящий вебхук. Права: crm, user, documentgenerator
BITRIX_WEBHOOK_URL=https://bitrix.b-integration.ru/rest/1/XXXXXXXXXXXX/
# Поле сотрудника с Telegram (логин, @логин, t.me/логин или числовой ID; можно несколько через пробел)
BITRIX_TELEGRAM_FIELD=UF_USR_1794934830441
# 31 = смарт-счета
INVOICE_ENTITY_TYPE_ID=31
# ID шаблона печатной формы; пусто/0 = первый активный шаблон счёта
INVOICE_TEMPLATE_ID=0
# Срок оплаты (дней), если у счёта-образца его нет
INVOICE_PAY_DAYS=5

# ---- Модель ----
# openai или anthropic (если пусто — по тому, какой ключ задан)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Любая модель OpenAI с поддержкой function calling
OPENAI_MODEL=gpt-5.6-terra
# responses (рекомендуется) или chat
OPENAI_API_MODE=responses
# Насколько модель «думает»: none/low/medium/high. Пусто = low (для chat — none)
OPENAI_REASONING_EFFORT=
# Распознавание голосовых сообщений
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Необязательно: свой адрес API (прокси, совместимый сервис)
OPENAI_BASE_URL=

# Если захочется Claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

TIMEZONE=Asia/Irkutsk
